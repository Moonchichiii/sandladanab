# =========================
# OS / Editor junk
# =========================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.stackdump

# VS Code / JetBrains
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.iml
.history/
.vs/

# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*$py.class

# Packaging / builds
build/
dist/
.eggs/
*.egg-info/
pip-wheel-metadata/
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
env/
.venv/
venv/
venv-*/
ENV/
.python-version

# Testing / type-check caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.pytype/
.pyrightcache/
.ruff_cache/
.cache/

# Local databases
*.sqlite3
*.db
*.db-journal

# =========================
# FastAPI / Starlette
# =========================
# File uploads & generated media
uploads/
media/
# If you generate thumbs/renditions, keep them out too:
static/generated/
static/.cache/

# =========================
# Node / Tailwind / PostCSS
# =========================
node_modules/
.pnpm-store/
.npm/
.eslintcache
.stylelintcache
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Tailwind builds (only ignore source maps)
static/dist/*.map

# If you generate other asset bundles, ignore them too:
public/build/
assets/build/

# =========================
# Environment / Secrets
# =========================
.env
.env.*
!.env.example
!.env.test.example

# =========================
# Docker / Compose (local-only overrides)
# =========================
docker-compose.override.yml
.docker/
**/.dockerignore.local

# =========================
# Coverage / CI Artifacts
# =========================
coverage.xml
pytest.xml
test-results/
junit*.xml

# =========================
# Misc
# =========================
# VSCode counters/metrics
.vscode-counter/
.vscode
# Temporary files
tmp/
temp/
*.tmp
*.swp
*.swo
*~
.env.example
